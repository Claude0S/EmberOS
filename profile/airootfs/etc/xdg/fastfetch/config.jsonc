// Ember OS — fastfetch config (system-wide).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/ember/fastfetch/fox.txt",
    "color": {
      "1": "38;2;232;135;90",
      "2": "38;2;251;238;224",
      "3": "38;2;42;28;38"
    },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": ": ",
    "color": {
      "keys": "38;2;243;164;108",
      "title": "38;2;243;164;108"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "theme",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "break",
    "colors"
  ]
}
