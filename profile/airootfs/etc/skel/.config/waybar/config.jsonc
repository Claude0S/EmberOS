// Ember OS — верхня панель: три «острівці»
{
  "layer": "top",
  "position": "top",
  "height": 44,
  "margin-top": 12,
  "margin-left": 16,
  "margin-right": 16,
  "spacing": 0,

  "modules-left": ["custom/ember", "hyprland/workspaces"],
  "modules-center": ["clock", "custom/weather"],
  "modules-right": ["custom/lang", "tray", "network", "bluetooth", "pulseaudio", "battery", "custom/notifications", "custom/power"],

  "custom/ember": {
    "format": "󰈺  Ember",
    "tooltip": false,
    "on-click": "fuzzel",
    "on-click-right": "/usr/local/bin/ember-toggle-shell"
  },

  "hyprland/workspaces": {
    "format": " ",
    "persistent-workspaces": { "*": 5 },
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },

  "clock": {
    "format": "<b>{0:%H:%M}</b>  <span alpha='75%'>{0:%a, %d %B}</span>",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": { "today": "<span color='#f3a46c'><b>{}</b></span>" }
    }
  },

  "custom/weather": {
    "exec": "curl -sf --max-time 8 'https://wttr.in/?format=%c%t&m' | sed 's/+//; s/ //g'",
    "interval": 1800,
    "format": "  {}",
    "tooltip": false,
    "on-click": "firefox --new-tab https://wttr.in"
  },

  "custom/lang": {
    "exec": "/usr/local/bin/ember-kb-layout",
    "format": "{}",
    "tooltip": false,
    "on-click": "hyprctl switchxkblayout all next"
  },

  "tray": { "icon-size": 15, "spacing": 8 },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format": "{essid}  {ipaddr}",
    "on-click": "nm-connection-editor"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "",
    "format-off": "",
    "format-connected": "󰂱",
    "on-click": "blueman-manager"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "battery": {
    "states": { "warning": 25, "critical": 12 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
  },

  "custom/notifications": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": { "notification": "󰂚", "none": "󰂜", "dnd-notification": "󰂛", "dnd-none": "󰂛" },
    "tooltip": false,
    "on-click": "swaync-client -t -sw"
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "/usr/local/bin/ember-power"
  }
}
