[Desktop Entry]
Type=Application
Name=Ember Office
Name[uk]=Ember Office
Name[ru]=Ember Office
Comment=Documents, presentations, spreadsheets
Comment[uk]=Документи, презентації, таблиці
Comment[ru]=Документы, презентации, таблицы
