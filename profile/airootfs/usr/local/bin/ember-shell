#!/usr/bin/env python3
"""
ember-shell — командная строка Ember OS.

Win+Enter открывает её на весь экран, /desktop возвращает рабочий стол.
Команды начинаются со слеша (/help — список). Всё остальное выполняется
как обычная команда терминала (bash).
"""
import json
import os
import re
import readline  # noqa: F401  (история и стрелки)
import shlex
import shutil
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
CFG_DIR = os.path.join(HOME, ".config", "ember")
LANG_FILE = os.path.join(CFG_DIR, "lang")
WIDGETS_FILE = os.path.join(CFG_DIR, "widgets.json")
HIST_FILE = os.path.join(CFG_DIR, "shell_history")
CATALOG = "/usr/share/ember/catalog.json"
LITTLE_MODE = "/usr/share/ember/little/mode.lua"
HYPR_MODE = os.path.join(HOME, ".config", "hypr", "mode.lua")

# ─── Цвета ───
O = "\033[38;2;232;135;90m"    # оранжевый
A = "\033[38;2;243;164;108m"   # янтарный
