#!/bin/bash
# Автотест установки (запускається ЛИШЕ з параметром ядра ember.autotest=1, тільки в CI).
# Повторює кроки установника Calamares на віртуальному диску /dev/vda:
#   перевірка конфігів Calamares → розмітка → копіювання системи → ядро →
#   ember-postinstall → користувач → initramfs → GRUB → вимкнення.
# Потім CI завантажується з цього диска і робить скриншоти.
exec > >(tee -a /dev/ttyS0 /var/log/ember-autotest.log) 2>&1
set -uo pipefail
say() { echo "EMBER-AUTOTEST: $*"; }
fail() { say "FAIL: $*"; sleep 2; systemctl poweroff; exit 1; }
# Тестовий диск — той, що на 30 ГБ (у CI він емулює SSD, як у ноутбуці)
D=/dev/$(lsblk -dnbo NAME,SIZE | awk '$2==32212254720{print $1; exit}')
case "$D" in /dev/nvme*|/dev/mmcblk*) P=${D}p1 ;; *) P=${D}1 ;; esac

say "start"
# CI швидкий перетест: свіжі конфіги Calamares з диска EMBERTEST
for c in /run/embertest/*.conf; do [ -f "$c" ] && cp "$c" /etc/calamares/modules/ && say "fresh config: $(basename "$c")"; done

# ─── 1. Статична перевірка Calamares ───
command -v calamares >/dev/null || fail "calamares not installed"
for m in $(sed -n '/^sequence:/,/^branding:/p' /etc/calamares/settings.conf | grep -E '^\s+- [a-z][a-z0-9@-]*\s*$' | sed -E 's/^\s+- //; s/@.*//; s/\s+$//' | sort -u); do
    [ -f "/usr/lib/calamares/modules/$m/module.desc" ] || [ -d "/usr/lib/calamares/modules/$m" ] \
        || [ -f "/usr/lib/calamares/modules/lib$m.so" ] || ls /usr/lib/calamares/modules/ | grep -qx "$m" \
        || fail "calamares module missing: $m"
    say "module ok: $m"
done
for c in /etc/calamares/modules/shellprocess_*.conf; do
    grep -oE '/usr/local/bin/[a-z-]+' "$c" | sort -u | while read -r b; do
        [ -x "$b" ] || { say "FAIL: $c references missing $b"; exit 1; }
    done || fail "shellprocess script missing"
done
[ -f /usr/share/calamares/branding/ember/branding.desc ] || fail "branding missing"
for b in unsquashfs rsync grub-install mkinitcpio; do command -v "$b" >/dev/null || fail "missing tool: $b"; done
say "calamares config ok"

# ─── 2. Образ системи (те саме, що робить ember-install) ───
sfs=$(/usr/local/bin/ember-find-sfs) || fail "system image not found"
mkdir -p /run/ember && ln -sf "$sfs" /run/ember/airootfs.sfs
src=$(grep -oE 'source: "[^"]+"' /etc/calamares/modules/unpackfs.conf | cut -d'"' -f2)
[ -e "$src" ] || fail "unpackfs source does not exist: $src"
say "image ok: $sfs (unpackfs source $src)"

# ─── 3. Розмітка (як «Стерти диск» у режимі BIOS) ───
[ -b "$D" ] || fail "no test disk $D"
wipefs -af "$D" >/dev/null
parted -s "$D" mklabel msdos mkpart primary ext4 1MiB 100% set 1 boot on || fail "parted"
udevadm settle
mkfs.ext4 -F -q -L root "$P" || fail "mkfs"
# Опції монтування — ті самі, що бере модуль mount Calamares з mount.conf
rot=$(cat "/sys/block/$(basename "$D")/queue/rotational" 2>/dev/null || echo 1)
opts=$(python3 - "$rot" <<'PY'
import re, sys
s = open("/etc/calamares/modules/mount.conf").read()
ssd = sys.argv[1] == "0"
def lst(block, key):
    m = re.search(r"^\s+" + key + r":\s*\[([^\]]*)\]", block, re.M)
    return [x.strip() for x in m.group(1).split(",") if x.strip()] if m else []
blocks = re.split(r"\n\s*- filesystem:", "\n" + s.split("mountOptions:")[1])
o = []
for b in blocks:
    name = b.strip().split()[0] if b.strip() else ""
    if name in ("default", "ext4"):
        o = lst(b, "options") + (lst(b, "ssdOptions") if ssd else lst(b, "hddOptions"))
print(",".join(o) or "defaults")
PY
)
say "disk $D rotational=$rot, mount options: $opts"
mount -o "$opts" "$P" /mnt || fail "mount with Calamares options ($opts) failed"
mountpoint -q /mnt || fail "target not mounted"
say "partition ok"

# ─── 4. unpackfs — так само, як модуль unpackfs Calamares (mount squashfs + rsync) ───
sum="${sfs%.sfs}.sha512"
if [ -f "$sum" ]; then
    (cd "$(dirname "$sfs")" && sha512sum -c --status "$(basename "$sum")") && say "image checksum ok" || fail "image checksum mismatch"
else
    say "warning: no $sum on the ISO"
fi
mkdir -p /run/ember/src
mount -t squashfs -o loop,ro "$src" /run/ember/src || fail "mount squashfs"
rsync -aHAXSr --filter='-x trusted.*' --filter='-x security.evm' \
      --exclude /proc/ --exclude /sys/ --exclude /dev/ --exclude /run/ --exclude /tmp/ \
      /run/ember/src/ /mnt/
rc=$?
umount /run/ember/src
[ $rc -eq 0 ] || fail "rsync exit code $rc"
mkdir -p /mnt/proc /mnt/sys /mnt/dev /mnt/run /mnt/tmp
say "unpack ok (rsync)"
# CI швидкий перетест: свіжі скрипти з диска EMBERTEST — і в нову систему теж
if mountpoint -q /run/embertest 2>/dev/null; then
    for f in /run/embertest/ember-*; do
        case "$(basename "$f")" in ember-autotest*) continue ;; esac
        install -m 755 "$f" "/mnt/usr/local/bin/$(basename "$f")"
    done
    say "fresh scripts injected"
fi

# ─── 5. shellprocess@before ───
/usr/local/bin/ember-copy-kernel /mnt || fail "ember-copy-kernel"
cp -L /etc/resolv.conf /mnt/etc/resolv.conf 2>/dev/null || true
# fstab — лише корінь (як модуль fstab Calamares), ДО bind-монтувань /dev /run …
echo "UUID=$(blkid -s UUID -o value "$P")  /  ext4  defaults,noatime  0 1" > /mnt/etc/fstab
for d in dev proc sys run; do mount --rbind "/$d" "/mnt/$d"; done
say "kernel+fstab ok: $(ls /mnt/boot)"

# ─── 6. users + shellprocess@ember ───
chroot /mnt /bin/bash -c '
    useradd -m -s /bin/bash -G wheel,video,audio,input tester &&
    echo "tester:tester" | chpasswd && echo "root:root" | chpasswd &&
    echo "%wheel ALL=(ALL) ALL" > /etc/sudoers.d/10-wheel && chmod 440 /etc/sudoers.d/10-wheel &&
    echo ember-test > /etc/hostname' || fail "users"
chroot /mnt /usr/local/bin/ember-postinstall || fail "ember-postinstall"
# Маячок для CI: встановлена система після завантаження пише в серійний порт
cat > /mnt/etc/systemd/system/ember-ci-beacon.service <<'EOB'
[Unit]
Description=CI beacon (autotest only)
After=sddm.service
[Service]
Type=oneshot
ExecStart=/usr/local/bin/ember-ci-beacon
[Install]
WantedBy=multi-user.target
EOB
cat > /mnt/usr/local/bin/ember-ci-beacon <<'EOB'
#!/bin/sh
say() { echo "EMBER-INSTALLED: $*" > /dev/ttyS0; }
say "multi-user OK"
for i in $(seq 90); do pgrep -x Hyprland >/dev/null && { say "Hyprland running"; break; }; sleep 1; done
# Фонова докачка Steam / Wine / Hydra (до 25 хв)
for i in $(seq 300); do
    st=$(cat /var/lib/ember/apps-status 2>/dev/null)
    case "$st" in done|failed) break ;; esac
    sleep 5
done
say "apps ${st:-none}"
ls /var/lib/ember/ | tr '\n' ' ' > /dev/ttyS0; echo > /dev/ttyS0
[ "$st" = done ] || tail -40 /var/log/ember-setup-apps.log > /dev/ttyS0 2>/dev/null
pacman -Q steam wine 2>&1 | sed 's/^/EMBER-INSTALLED: pkg /' > /dev/ttyS0
[ -x /opt/hydra/hydra.AppImage ] && say "hydra installed"
# Скріншоти лаунчера й антивірусу (у сесії tester)
U=$(id -u tester); R=/run/user/$U
SIG=$(ls "$R/hypr" 2>/dev/null | head -1)
asu() { su tester -c "env XDG_RUNTIME_DIR=$R HYPRLAND_INSTANCE_SIGNATURE=$SIG WAYLAND_DISPLAY=wayland-1 $*"; }
hx() {   # запустити в сесії Hyprland: hx <ім'я> <команда…>
    printf '#!/bin/sh\n%s\n' "$2" > "/tmp/hx-$1.sh"; chmod 755 "/tmp/hx-$1.sh"
    asu "hyprctl dispatch 'hl.dsp.exec_cmd(\"/tmp/hx-$1.sh\")'" >/dev/null 2>&1
}
hx launcher "quickshell -p /usr/share/ember/launcher/shell.qml >/tmp/ql.log 2>&1"
sleep 10
say "launcher shown"
sleep 8
grep -iE "warn|error|fail" /tmp/ql.log 2>/dev/null | head -20 | sed 's/^/EMBER-INSTALLED: qml launcher: /' > /dev/ttyS0
pkill -f "launcher/shell.qml"
if command -v clamscan >/dev/null && ls /var/lib/clamav/*.c[vl]d >/dev/null 2>&1; then
    H=$(getent passwd tester | cut -d: -f6); mkdir -p "$H/Downloads"
    printf '%s' 'X5O!P%@AP[4\PZX54(P^)7CC)7}$EICAR-STANDARD-ANTIVIRUS-TEST-FILE!$H+H*' > "$H/Downloads/eicar-test.exe"
    chown -R tester: "$H/Downloads"
    asu "ember-av scan quick" >/dev/null 2>&1
    for i in $(seq 120); do
        asu "ember-av status" 2>/dev/null | grep -q '"state": "\(done\|failed\)"' && break; sleep 3
    done
    say "av $(asu 'ember-av status' | python3 -c 'import json,sys;d=json.load(sys.stdin);s=d.get("scan") or {};print(s.get("state"), "found", len(s.get("found",[])))')"
fi
hx antivirus "quickshell -p /usr/share/ember/antivirus/shell.qml >/tmp/qa.log 2>&1"
sleep 10
say "antivirus shown"
sleep 8
grep -iE "warn|error|fail" /tmp/qa.log 2>/dev/null | head -20 | sed 's/^/EMBER-INSTALLED: qml antivirus: /' > /dev/ttyS0
EOB
chmod 755 /mnt/usr/local/bin/ember-ci-beacon
ln -sf /etc/systemd/system/ember-ci-beacon.service /mnt/etc/systemd/system/multi-user.target.wants/ember-ci-beacon.service
# Для скриншота після перезавантаження — автовхід тестового користувача
mkdir -p /mnt/etc/sddm.conf.d
printf '[Autologin]\nUser=tester\nSession=hyprland.desktop\n' > /mnt/etc/sddm.conf.d/99-autotest.conf
say "postinstall ok"

# ─── 7. initcpio + bootloader ───
chroot /mnt mkinitcpio -P || fail "mkinitcpio"
chroot /mnt grub-install --target=i386-pc "$D" || fail "grub-install"
# Тільки для тесту: дублювати консоль ядра в серійний порт (для маячка)
sed -i 's|^GRUB_CMDLINE_LINUX=.*|GRUB_CMDLINE_LINUX="console=ttyS0,115200 console=tty0"|' /mnt/etc/default/grub
chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg || fail "grub-mkconfig"
grep -q "ember" /mnt/boot/grub/grub.cfg || say "warning: no ember theme in grub.cfg"
chroot /mnt systemctl enable NetworkManager sddm >/dev/null 2>&1
say "boot files: $(ls /mnt/boot)"

sync
umount -R /mnt || true
say "OK"
sleep 2
systemctl poweroff
