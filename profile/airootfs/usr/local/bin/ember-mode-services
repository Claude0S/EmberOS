#!/bin/bash
# Что ещё меняется в режимах /little и /full (кроме настроек Hyprland)
case "${1:-full}" in
    little)
        pkill -fx quickshell 2>/dev/null          # виджеты выключены
        pkill -x nwg-dock-hyprland 2>/dev/null   # док без анимаций —
        nwg-dock-hyprland -x -i 36 -mb 8 -c fuzzel >/dev/null 2>&1 &
        command -v powerprofilesctl >/dev/null && powerprofilesctl set power-saver 2>/dev/null
        ;;
    full)
        pgrep -fx quickshell >/dev/null || (quickshell >/dev/null 2>&1 &)
        command -v powerprofilesctl >/dev/null && powerprofilesctl set balanced 2>/dev/null
        ;;
esac
exit 0
