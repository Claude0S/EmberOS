#!/bin/bash
# Меню питания Ember OS
. /usr/share/ember/i18n.sh
L_LOCK=$(msg "Заблокувати" "Lock" "Заблокировать"); L_SLEEP=$(msg "Сон" "Sleep" "Сон"); L_OUT=$(msg "Вийти" "Log out" "Выйти")
L_RB=$(msg "Перезавантажити" "Restart" "Перезагрузить"); L_OFF=$(msg "Вимкнути" "Shut down" "Выключить")
choice=$(printf '󰌾  %s\n󰤄  %s\n󰍃  %s\n󰜉  %s\n󰐥  %s\n' "$L_LOCK" "$L_SLEEP" "$L_OUT" "$L_RB" "$L_OFF" \
    | fuzzel --dmenu --lines 5 --width 24 --prompt "⏻  ")

case "$choice" in
    *"$L_LOCK"*)  loginctl lock-session ;;
    *"$L_SLEEP"*) systemctl suspend ;;
    *"$L_OUT"*)         command -v hyprshutdown >/dev/null && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()' ;;
    *"$L_RB"*)    systemctl reboot ;;
    *"$L_OFF"*)   systemctl poweroff ;;
esac
