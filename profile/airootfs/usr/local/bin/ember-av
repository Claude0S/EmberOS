#!/usr/bin/env python3
"""ember-av — серце Ember Антивірусу (ClamAV + ufw). Вікно: ember-antivirus.

  ember-av status                 JSON для вікна
  ember-av scan quick|full|<dir>  перевірка у фоні (знайдене одразу йде в карантин)
  ember-av cancel                 зупинити перевірку
  ember-av quarantine             JSON-список карантину
  ember-av restore <id>           повернути файл на місце
  ember-av delete <id>            видалити назавжди
  ember-av install|update         встановити ClamAV / оновити бази (пароль)
  ember-av firewall on|off        файрвол (пароль)
"""
import glob, json, os, shutil, signal, subprocess, sys, tempfile, time, uuid

HOME = os.path.expanduser("~")
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", HOME + "/.local/state"), "ember")
SCAN = os.path.join(STATE_DIR, "av-scan.json")
LAST = os.path.join(STATE_DIR, "av-last.json")
JOB = os.path.join(STATE_DIR, "av-job.json")
QDIR = os.path.join(HOME, ".local/share/ember/quarantine")
DBDIR = "/var/lib/clamav"
ROOT_HELPER = "/usr/local/bin/ember-av-root"


def lang():
    try:
        l = open(HOME + "/.config/ember/lang").read().strip()
        if l in ("uk", "en", "ru"):
            return l
    except OSError:
        pass
    return {"en": "en", "ru": "ru"}.get(os.environ.get("LANG", "")[:2], "uk")


def tr(uk, en, ru):
    return {"uk": uk, "en": en, "ru": ru}[lang()]


def jload(p, default=None):
    try:
        with open(p) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def jsave(p, data):
    os.makedirs(os.path.dirname(p), exist_ok=True)
    tmp = p + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, ensure_ascii=False)
    os.replace(tmp, p)


def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def notify(title, body, urgent=False):
    cmd = ["notify-send", "-a", "Ember OS", "-i", "/usr/share/ember/icons/fox-avatar.png"]
    if urgent:
        cmd += ["-u", "critical"]
    try:
        subprocess.Popen(cmd + [title, body], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def db_info():
    files = [p for p in glob.glob(DBDIR + "/*.c[vl]d")]
    if not files:
        return False, 0
    return True, int(max(os.path.getmtime(p) for p in files))


def firewall_on():
    try:
        active = subprocess.run(["systemctl", "is-active", "-q", "ufw"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
        conf = open("/etc/ufw/ufw.conf").read()
        return active and "ENABLED=yes" in conf
    except OSError:
        return False


def quarantine_list():
    out = []
    for meta in sorted(glob.glob(QDIR + "/*/meta.json")):
        m = jload(meta, {})
        m["id"] = os.path.basename(os.path.dirname(meta))
        out.append(m)
    out.sort(key=lambda m: -m.get("time", 0))
    return out


def cmd_status():
    scan = jload(SCAN)
    if scan and scan.get("state") == "running" and not alive(scan.get("pid")):
        scan["state"] = "failed"
    job = jload(JOB)
    if job and not alive(job.get("pid")):
        job = None if job.get("state") == "running" else job
    db_ok, db_time = db_info()
    st = {
        "installed": bool(shutil.which("clamscan")),
        "db": db_ok, "dbTime": db_time,
        "firewall": firewall_on(),
        "firewallInstalled": bool(shutil.which("ufw")),
        "quarantine": len(quarantine_list()),
        "last": jload(LAST),
        "scan": scan,
        "job": job,
    }
    json.dump(st, sys.stdout, ensure_ascii=False)


# ─── перевірка ───

QUICK_EXT = {".exe", ".msi", ".dll", ".scr", ".bat", ".cmd", ".ps1", ".vbs", ".js", ".jar", ".zip", ".rar",
             ".7z", ".iso", ".appimage", ".sh", ".pdf", ".doc", ".docm", ".xls", ".xlsm", ".lnk", ".com", ".apk"}
SKIP_DIRS = {".cache", "node_modules", ".git", "quarantine", "Trash", ".local/share/Steam/steamapps/shadercache"}


def user_dir(kind, fallback):
    try:
        p = subprocess.run(["xdg-user-dir", kind], capture_output=True, text=True).stdout.strip()
        if p and p != HOME and os.path.isdir(p):
            return p
    except OSError:
        pass
    return fallback


def targets(kind):
    if kind == "quick":
        dirs = {user_dir("DOWNLOAD", HOME + "/Downloads"), user_dir("DESKTOP", HOME + "/Desktop"),
                HOME + "/Downloads", HOME + "/Desktop", HOME + "/Games", HOME + "/.wine/drive_c/users",
                HOME + "/.local/share/applications", "/tmp"}
        return [d for d in dirs if os.path.isdir(d)], True
    if kind == "full":
        return [HOME], False
    return [os.path.abspath(os.path.expanduser(kind))], False


def collect(dirs, quick):
    files, seen = [], set()
    uid = os.getuid()
    for d in dirs:
        if os.path.isfile(d):
            files.append(d)
            continue
        for root, subdirs, names in os.walk(d, onerror=lambda e: None):
            rel = os.path.relpath(root, HOME)
            subdirs[:] = [s for s in subdirs if s not in SKIP_DIRS and os.path.join(rel, s) not in SKIP_DIRS
                          and not os.path.islink(os.path.join(root, s))]
            for n in names:
                p = os.path.join(root, n)
                if p in seen:
                    continue
                if quick and os.path.splitext(n)[1].lower() not in QUICK_EXT:
                    continue
                try:
                    stt = os.lstat(p)
                except OSError:
                    continue
                if not (stt.st_mode & 0o170000 == 0o100000) or stt.st_size == 0 or stt.st_size > 200 * 1024 * 1024:
                    continue
                if root.startswith("/tmp") and stt.st_uid != uid:
                    continue
                seen.add(p)
                files.append(p)
    return files


def quarantine(path, sig):
    qid = time.strftime("%Y%m%d-%H%M%S-") + uuid.uuid4().hex[:6]
    d = os.path.join(QDIR, qid)
    os.makedirs(d, exist_ok=True)
    os.chmod(QDIR, 0o700)
    try:
        shutil.move(path, os.path.join(d, "data"))
        os.chmod(os.path.join(d, "data"), 0)
        jsave(os.path.join(d, "meta.json"), {"path": path, "name": os.path.basename(path), "sig": sig, "time": int(time.time())})
        return True
    except OSError:
        shutil.rmtree(d, ignore_errors=True)
        return False


def worker(kind):
    start = time.time()
    st = {"state": "loading", "pid": os.getpid(), "kind": kind, "total": 0, "done": 0, "current": "",
          "found": [], "started": int(start), "elapsed": 0}
    jsave(SCAN, st)
    dirs, quick = targets(kind)
    files = collect(dirs, quick)
    st["total"] = len(files)
    jsave(SCAN, st)
    if not files:
        st.update(state="done", elapsed=int(time.time() - start))
        jsave(SCAN, st)
        jsave(LAST, {"time": int(time.time()), "kind": kind, "files": 0, "found": 0})
        return
    lst = tempfile.NamedTemporaryFile("w", delete=False, prefix="ember-av-", suffix=".txt")
    lst.write("\n".join(files) + "\n")
    lst.close()
    proc = subprocess.Popen(["clamscan", "--no-summary", "--stdout", "--file-list=" + lst.name,
                             "--max-filesize=200M", "--max-scansize=400M"],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, errors="replace")
    st["clamPid"] = proc.pid
    last_write = 0
    for line in proc.stdout:
        line = line.rstrip("\n")
        if ": " not in line:
            continue
        path, res = line.rsplit(": ", 1)
        st["state"] = "running"
        st["done"] = min(st["total"], st["done"] + 1)
        st["current"] = path
        if res.endswith(" FOUND"):
            sig = res[:-6]
            moved = quarantine(path, sig)
            st["found"].append({"path": path, "sig": sig, "quarantined": moved})
        now = time.time()
        if now - last_write > 0.4:
            st["elapsed"] = int(now - start)
            jsave(SCAN, st)
            last_write = now
    rc = proc.wait()
    os.unlink(lst.name)
    st["elapsed"] = int(time.time() - start)
    st["current"] = ""
    cur = jload(SCAN, {})
    if cur.get("state") == "cancelled":
        return
    if rc == 2 and st["done"] == 0:
        st["state"] = "failed"
        jsave(SCAN, st)
        notify(tr("Антивірус", "Antivirus", "Антивирус"),
               tr("Перевірка не вдалася — онови бази", "Scan failed — update the databases", "Проверка не удалась — обнови базы"), True)
        return
    st["state"] = "done"
    st["done"] = st["total"]
    jsave(SCAN, st)
    n = len(st["found"])
    jsave(LAST, {"time": int(time.time()), "kind": kind, "files": st["total"], "found": n})
    if n:
        notify(tr("Знайдено загроз: ", "Threats found: ", "Найдено угроз: ") + str(n),
               tr("Файли перенесено в карантин", "Files moved to quarantine", "Файлы перенесены в карантин") +
               "\n" + ", ".join(os.path.basename(f["path"]) for f in st["found"][:3]), True)
    else:
        notify(tr("Перевірку завершено", "Scan complete", "Проверка завершена"),
               tr("Загроз немає 🦊 · файлів: ", "No threats 🦊 · files: ", "Угроз нет 🦊 · файлов: ") + str(st["total"]))


def daemonize(args):
    subprocess.Popen([sys.executable, os.path.abspath(__file__)] + args, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def cmd_scan(kind):
    cur = jload(SCAN)
    if cur and cur.get("state") in ("loading", "running") and alive(cur.get("pid")):
        print("already running")
        return 1
    if not shutil.which("clamscan") or not db_info()[0]:
        # спершу встановити / завантажити бази, потім перевірка
        return cmd_job("install", then_scan=kind)
    daemonize(["_worker", kind])
    return 0


def cmd_cancel():
    cur = jload(SCAN)
    if not cur:
        return
    for k in ("clamPid", "pid"):
        if alive(cur.get(k)):
            try:
                os.kill(int(cur[k]), signal.SIGTERM)
            except OSError:
                pass
    cur["state"] = "cancelled"
    jsave(SCAN, cur)


def cmd_job(action, arg="", then_scan=""):
    """Дії з паролем (pkexec) у фоні, щоб вікно не зависало."""
    job = jload(JOB)
    if job and job.get("state") == "running" and alive(job.get("pid")):
        return 1
    daemonize(["_job", action, arg, then_scan])
    return 0


def job_worker(action, arg, then_scan):
    jsave(JOB, {"state": "running", "action": action, "pid": os.getpid()})
    cmd = ["pkexec", ROOT_HELPER, action] + ([arg] if arg else [])
    rc = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode
    jsave(JOB, {"state": "done" if rc == 0 else "failed", "action": action, "rc": rc, "time": int(time.time())})
    if rc != 0 and action != "firewall":
        notify(tr("Антивірус", "Antivirus", "Антивирус"),
               tr("Не вдалося (немає інтернету або скасовано пароль)", "Failed (no internet or password cancelled)",
                  "Не удалось (нет интернета или пароль отменён)"), True)
    if rc == 0 and then_scan:
        worker(then_scan)


def cmd_restore(qid):
    d = os.path.join(QDIR, os.path.basename(qid))
    m = jload(os.path.join(d, "meta.json"))
    if not m:
        return 1
    dest = m["path"]
    if os.path.exists(dest):
        dest += ".restored"
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    os.chmod(os.path.join(d, "data"), 0o600)
    shutil.move(os.path.join(d, "data"), dest)
    shutil.rmtree(d, ignore_errors=True)
    return 0


def cmd_delete(qid):
    d = os.path.join(QDIR, os.path.basename(qid))
    if os.path.isdir(d):
        try:
            os.chmod(os.path.join(d, "data"), 0o600)
        except OSError:
            pass
        shutil.rmtree(d, ignore_errors=True)
    return 0


def main():
    a = sys.argv[1:] or ["status"]
    c = a[0]
    if c == "status":
        cmd_status()
    elif c == "scan":
        sys.exit(cmd_scan(a[1] if len(a) > 1 else "quick") or 0)
    elif c == "cancel":
        cmd_cancel()
    elif c == "quarantine":
        json.dump(quarantine_list(), sys.stdout, ensure_ascii=False)
    elif c == "restore" and len(a) > 1:
        sys.exit(cmd_restore(a[1]))
    elif c == "delete" and len(a) > 1:
        sys.exit(cmd_delete(a[1]))
    elif c in ("install", "update"):
        sys.exit(cmd_job(c))
    elif c == "firewall" and len(a) > 1:
        sys.exit(cmd_job("firewall", a[1]))
    elif c == "_worker":
        worker(a[1])
    elif c == "_job":
        job_worker(a[1], a[2] if len(a) > 2 else "", a[3] if len(a) > 3 else "")
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
