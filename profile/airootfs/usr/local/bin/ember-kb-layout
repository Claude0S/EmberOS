#!/bin/bash
# Waybar: поточна розкладка клавіатури як EN / UA / RU (оновлюється миттєво)
map() {
    case "$1" in
        *Ukrain*|ua*) echo UA ;;
        *Russian*|ru*) echo RU ;;
        *) echo EN ;;
    esac
}
cur=$(hyprctl devices -j 2>/dev/null | jq -r '[.keyboards[] | select(.main)][0].active_keymap // empty')
[ -z "$cur" ] && cur=$(hyprctl devices -j 2>/dev/null | jq -r '.keyboards[0].active_keymap // "English"')
map "$cur"
sock="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
socat -u "UNIX-CONNECT:$sock" - 2>/dev/null | while IFS= read -r line; do
    case "$line" in
        activelayout\>\>*) map "${line##*,}" ;;
    esac
done
