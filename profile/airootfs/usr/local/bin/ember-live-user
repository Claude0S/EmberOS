#!/bin/bash
# Живая сессия: создаёт пользователя "ember" без пароля и с sudo.
# Запускается только на флешке (см. ember-live-user.service).
set -e
if ! id ember >/dev/null 2>&1; then
    groups=""
    for g in wheel video audio input network storage lp render; do
        getent group "$g" >/dev/null && groups="${groups:+$groups,}$g"
    done
    useradd -m -s /bin/bash -c "Ember" -G "$groups" ember
    passwd -d ember >/dev/null
fi
install -m 440 /dev/stdin /etc/sudoers.d/10-ember-live <<'EOF'
ember ALL=(ALL) NOPASSWD: ALL
EOF

# Живая сессия: значок установщика первым в доке
pinned=/home/ember/.cache/nwg-dock-pinned
if [ -f "$pinned" ] && ! grep -qx os.ember.Welcome "$pinned"; then
    sed -i '1i os.ember.Welcome' "$pinned"
fi
chown -R ember: /home/ember/.cache 2>/dev/null || true
