#!/bin/bash
# Знаходить образ системи живої сесії (на флешці або скопійований у памʼять)
for f in /run/archiso/bootmnt/arch/x86_64/airootfs.sfs /run/archiso/copytoram/airootfs.sfs \
         /run/archiso/bootmnt/*/x86_64/airootfs.sfs /run/archiso/copytoram/*.sfs; do
    [ -f "$f" ] && { readlink -f "$f"; exit 0; }
done
exit 1
