#!/usr/bin/env python3
"""Ember Office — документи, презентації й таблиці в стилі Ember.
Під капотом LibreOffice (повна сумісність з .docx/.pptx/.xlsx), але вигляд, шаблони й кольори — свої.

  ember-office                         головне вікно
  ember-office --new write|slides|sheets [варіант]
  ember-office --apply-theme           перефарбувати LibreOffice під поточну тему (викликає /theme)
  ember-office --template KIND VAR OUT шаблон у файл (для тестів)
"""
import datetime
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.parse
import xml.etree.ElementTree as ET

sys.path.insert(0, "/usr/share/ember/python")
import ember_odf  # noqa: E402

HOME = os.path.expanduser("~")
LO_PKGS = ["libreoffice-fresh", "libreoffice-fresh-uk", "libreoffice-fresh-ru", "ttf-carlito", "ttf-caladea"]
APP = {"write": "--writer", "slides": "--impress", "sheets": "--calc"}
ICON = {k: f"/usr/share/icons/hicolor/scalable/apps/ember-{k}.svg" for k in ("write", "slides", "sheets", "office")}
OFFICE_EXT = {".odt": "write", ".ott": "write", ".docx": "write", ".doc": "write", ".rtf": "write", ".txt": "write",
              ".odp": "slides", ".otp": "slides", ".pptx": "slides", ".ppt": "slides",
              ".ods": "sheets", ".ots": "sheets", ".xlsx": "sheets", ".xls": "sheets", ".csv": "sheets", ".pdf": "write"}


def lo_installed():
    return bool(shutil.which("soffice") or shutil.which("libreoffice"))


def soffice(args):
    exe = shutil.which("soffice") or "libreoffice"
    env = dict(os.environ, GTK_THEME=os.environ.get("GTK_THEME", "Adwaita:dark"))
    subprocess.Popen([exe] + args, env=env, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ─── вигляд LibreOffice: темні іконки, вкладки як у Word, кольори теми, .docx за замовчуванням ───
XCU = os.path.join(HOME, ".config/libreoffice/4/user/registrymodifications.xcu")


def lo_settings(t):
    def colour(h):
        return str(int(h.lstrip("#"), 16))
    tm = "org.openoffice.Office.UI.ToolbarMode:Application"
    fac = "org.openoffice.Setup:Factory"
    cs = "org.openoffice.Office.UI/ColorScheme/ColorSchemes/org.openoffice.Office.UI:ColorScheme['Ember']"
    return [
        ("/org.openoffice.Office.Common/Misc", "SymbolStyle", "colibre_dark"),
        ("/org.openoffice.Office.Common/Misc", "ShowTipOfTheDay", "false"),
        ("/org.openoffice.Office.Common/Misc", "FirstRun", "false"),
        ("/org.openoffice.Office.Common/Save/Document", "WarnAlienFormat", "false"),
        ("/org.openoffice.Office.Common/Appearance", "ApplicationAppearance", "2"),
        (f"/org.openoffice.Office.UI.ToolbarMode/Applications/{tm}['Writer']", "Active", "notebookbar.ui"),
        (f"/org.openoffice.Office.UI.ToolbarMode/Applications/{tm}['Impress']", "Active", "notebookbar.ui"),
        (f"/org.openoffice.Office.UI.ToolbarMode/Applications/{tm}['Calc']", "Active", "notebookbar.ui"),
        (f"/org.openoffice.Setup/Office/Factories/{fac}['com.sun.star.text.TextDocument']", "ooSetupFactoryDefaultFilter", "MS Word 2007 XML"),
        (f"/org.openoffice.Setup/Office/Factories/{fac}['com.sun.star.presentation.PresentationDocument']", "ooSetupFactoryDefaultFilter", "Impress MS PowerPoint 2007 XML"),
        (f"/org.openoffice.Setup/Office/Factories/{fac}['com.sun.star.sheet.SpreadsheetDocument']", "ooSetupFactoryDefaultFilter", "Calc MS Excel 2007 XML"),
        ("/org.openoffice.Office.UI/ColorScheme", "CurrentColorScheme", "Ember"),
        (f"/{cs}/AppBackground", "Color", colour(t["bg"])),
        (f"/{cs}/DocBoundaries", "Color", colour(t["surface"])),
        (f"/{cs}/Links", "Color", colour(t["accent"])),
    ]


def lo_version():
    try:
        out = subprocess.run(["pacman", "-Q", "libreoffice-fresh"], capture_output=True, text=True).stdout.split()
        m = re.match(r"(\d+\.\d+)", out[1]) if len(out) > 1 else None
        return m.group(1) if m else ""
    except OSError:
        return ""


def apply_lo_theme(t):
    """Пише налаштування в профіль LibreOffice (поки офіс закритий — інакше він їх перезапише)."""
    if subprocess.run(["pgrep", "-f", "soffice.bin"], stdout=subprocess.DEVNULL).returncode == 0:
        return False
    os.makedirs(os.path.dirname(XCU), exist_ok=True)
    if os.path.exists(XCU):
        s = open(XCU, encoding="utf-8").read()
    else:
        s = ('<?xml version="1.0" encoding="UTF-8"?>\n<oor:items xmlns:oor="http://openoffice.org/2001/registry" '
             'xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">\n</oor:items>\n')
    items = lo_settings(t)
    v = lo_version()
    if v:   # без вікна «Ласкаво просимо / що нового» при першому запуску
        items += [("/org.openoffice.Setup/Product", "ooSetupLastVersion", v),
                  ("/org.openoffice.Setup/Office", "ooSetupInstCompleted", "true")]
    for path, name, value in items:
        item = (f'<item oor:path="{path}"><prop oor:name="{name}" oor:op="fuse"><value>{value}</value></prop></item>')
        pat = re.compile(r'<item oor:path="' + re.escape(path) + r'"><prop oor:name="' + re.escape(name) + r'"[^>]*>.*?</prop></item>', re.S)
        if pat.search(s):
            s = pat.sub(lambda _m: item, s, count=1)
        else:
            s = s.replace("</oor:items>", item + "\n</oor:items>")
    with open(XCU + ".tmp", "w", encoding="utf-8") as f:
        f.write(s)
    os.replace(XCU + ".tmp", XCU)
    return True


# ─── недавні документи (з recently-used.xbel, туди пише й LibreOffice) ───
def recent_docs(limit=8):
    p = os.path.join(HOME, ".local/share/recently-used.xbel")
    out, seen = [], set()
    try:
        root = ET.parse(p).getroot()
    except (OSError, ET.ParseError):
        return out
    for bm in root.iter("bookmark"):
        href = bm.get("href", "")
        if not href.startswith("file://"):
            continue
        path = urllib.parse.unquote(href[7:])
        ext = os.path.splitext(path)[1].lower()
        if ext not in OFFICE_EXT or ext == ".pdf" or path in seen or not os.path.exists(path) or path.startswith("/tmp/"):
            continue
        seen.add(path)
        ts = bm.get("modified") or bm.get("visited") or ""
        try:
            when = datetime.datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
        except ValueError:
            when = os.path.getmtime(path)
        out.append({"path": path, "kind": OFFICE_EXT[ext], "time": when})
    out.sort(key=lambda d: -d["time"])
    return out[:limit]


def new_doc(kind, variant, t, lang):
    d = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "ember-office")
    os.makedirs(d, exist_ok=True)
    path = os.path.join(d, f"{kind}-{variant}-{int(time.time())}{ember_odf.EXT[kind]}")
    ember_odf.make(kind, variant, t, lang, path)
    apply_lo_theme(t)
    soffice([APP[kind], "-n", path])


def cli():
    a = sys.argv[1:]
    if not a:
        return False
    from ember_ui import lang, theme  # noqa: E402  (без GTK-вікна)
    if a[0] == "--apply-theme":
        apply_lo_theme(theme())
        return True
    if a[0] == "--template" and len(a) >= 4:
        ember_odf.make(a[1], a[2], theme(), lang(), a[3])
        return True
    if a[0] == "--new" and len(a) >= 2 and a[1] in APP:
        if not lo_installed():
            return False          # відкриємо вікно — там кнопка «Встановити»
        new_doc(a[1], a[2] if len(a) > 2 else ("dark" if a[1] == "slides" else "blank"), theme(), lang())
        return True
    if a[0] not in ("--new",) and os.path.exists(a[0]):
        apply_lo_theme(theme())
        soffice([a[0]])
        return True
    return False


if cli():
    sys.exit(0)

# ───────────────────────── вікно ─────────────────────────
import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

from ember_ui import ThemedCss, lang, rgba, tr  # noqa: E402


def css(t):
    a, a2, a3, fg, bg, sf = t["accent"], t["accent2"], t.get("accent3", t["accent2"]), t["fg"], t["bg"], t["surface"]
    return f"""
window.ember-office, window.ember-office > * {{ background: {bg}; color: {fg}; }}
.eo-title {{ font-size: 26px; font-weight: 800; }}
.eo-title-accent {{ color: {a}; font-size: 26px; font-weight: 800; }}
.eo-sub {{ color: {rgba(fg, 0.6)}; }}
.eo-section {{ color: {a2}; font-size: 12px; font-weight: 800; letter-spacing: 1px; }}
button.eo-card {{ background: {rgba(sf, 0.4)}; border-radius: 22px; padding: 18px; border: 1px solid {rgba(fg, 0.08)};
                 box-shadow: none; transition: all 150ms ease; }}
button.eo-card:hover {{ background: {rgba(sf, 0.7)}; border-color: {rgba(a, 0.6)}; }}
.eo-card-name {{ font-size: 18px; font-weight: 800; }}
.eo-card-desc {{ color: {rgba(fg, 0.6)}; font-size: 12px; }}
.eo-stripe-write {{ background: {a}; border-radius: 3px; min-height: 5px; }}
.eo-stripe-slides {{ background: {a2}; border-radius: 3px; min-height: 5px; }}
.eo-stripe-sheets {{ background: {a3}; border-radius: 3px; min-height: 5px; }}
button.eo-chip {{ background: {rgba(sf, 0.3)}; color: {rgba(fg, 0.85)}; border-radius: 14px; padding: 4px 12px;
                 min-height: 26px; border: none; box-shadow: none; font-size: 12px; }}
button.eo-chip:hover {{ background: {rgba(a, 0.3)}; color: {fg}; }}
button.eo-primary {{ background: {a}; color: {bg}; border-radius: 16px; padding: 8px 18px; font-weight: 800; border: none; box-shadow: none; }}
button.eo-primary:hover {{ background: {a2}; }}
button.eo-ghost {{ background: {rgba(sf, 0.4)}; color: {fg}; border-radius: 16px; padding: 8px 18px; font-weight: 700; border: none; box-shadow: none; }}
button.eo-ghost:hover {{ background: {rgba(sf, 0.7)}; }}
button.eo-recent {{ background: {rgba(sf, 0.25)}; border-radius: 16px; padding: 10px 14px; border: none; box-shadow: none; }}
button.eo-recent:hover {{ background: {rgba(a, 0.18)}; }}
.eo-recent-name {{ font-weight: 700; }}
.eo-recent-meta {{ color: {rgba(fg, 0.5)}; font-size: 11px; }}
.eo-banner {{ background: {rgba(a, 0.16)}; border: 1px solid {rgba(a, 0.5)}; border-radius: 16px; padding: 12px 16px; }}
.eo-empty {{ color: {rgba(fg, 0.45)}; padding: 16px; }}
"""


CARDS = [
    ("write", "Ember Write", lambda: tr("Документи — як Word", "Documents — like Word", "Документы — как Word"),
     [("blank", lambda: tr("Порожній", "Blank", "Пустой")), ("letter", lambda: tr("Лист", "Letter", "Письмо")),
      ("resume", lambda: tr("Резюме", "Resume", "Резюме")), ("report", lambda: tr("Звіт", "Report", "Отчёт"))]),
    ("slides", "Ember Slides", lambda: tr("Презентації — як PowerPoint", "Presentations — like PowerPoint", "Презентации — как PowerPoint"),
     [("dark", lambda: tr("Темна", "Dark", "Тёмная")), ("light", lambda: tr("Світла", "Light", "Светлая"))]),
    ("sheets", "Ember Sheets", lambda: tr("Таблиці — як Excel", "Spreadsheets — like Excel", "Таблицы — как Excel"),
     [("blank", lambda: tr("Порожня", "Blank", "Пустая")), ("budget", lambda: tr("Бюджет", "Budget", "Бюджет"))]),
]


class Office(Adw.Application):
    def __init__(self):
        super().__init__(application_id="os.ember.Office", flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.installing = False

    def do_activate(self):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        self.css = ThemedCss(css, self.on_theme)
        self.win = Gtk.ApplicationWindow(application=self, title="Ember Office")
        self.win.set_default_size(960, 600)
        self.win.set_decorated(False)
        self.win.add_css_class("ember-office")
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18, margin_top=22, margin_bottom=22,
                        margin_start=28, margin_end=28)
        self.win.set_child(outer)

        # шапка
        head = Gtk.Box(spacing=14)
        self.fox = Gtk.Image.new_from_file(self.css.t["fox"])
        self.fox.set_pixel_size(58)
        head.append(self.fox)
        tbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
        tl = Gtk.Box(spacing=8)
        l1 = Gtk.Label(label="Ember")
        l1.add_css_class("eo-title")
        l2 = Gtk.Label(label="Office")
        l2.add_css_class("eo-title-accent")
        tl.append(l1)
        tl.append(l2)
        tbox.append(tl)
        sub = Gtk.Label(label=tr("Документи, презентації й таблиці — відкриває та зберігає .docx, .pptx, .xlsx",
                                 "Documents, presentations and spreadsheets — opens and saves .docx, .pptx, .xlsx",
                                 "Документы, презентации и таблицы — открывает и сохраняет .docx, .pptx, .xlsx"), xalign=0)
        sub.add_css_class("eo-sub")
        tbox.append(sub)
        head.append(tbox)
        sp = Gtk.Box(hexpand=True)
        head.append(sp)
        ob = Gtk.Button(label=tr("Відкрити файл…", "Open file…", "Открыть файл…"), valign=Gtk.Align.CENTER)
        ob.add_css_class("eo-ghost")
        ob.connect("clicked", self.open_file)
        head.append(ob)
        outer.append(head)

        # банер встановлення
        self.banner = Gtk.Box(spacing=12)
        self.banner.add_css_class("eo-banner")
        self.ban_text = Gtk.Label(xalign=0, hexpand=True, wrap=True)
        self.ban_btn = Gtk.Button(label=tr("Встановити", "Install", "Установить"))
        self.ban_btn.add_css_class("eo-primary")
        self.ban_btn.connect("clicked", self.install)
        self.ban_spin = Gtk.Spinner()
        self.banner.append(self.ban_text)
        self.banner.append(self.ban_spin)
        self.banner.append(self.ban_btn)
        outer.append(self.banner)

        # створити
        s1 = Gtk.Label(label=tr("СТВОРИТИ", "CREATE", "СОЗДАТЬ"), xalign=0)
        s1.add_css_class("eo-section")
        outer.append(s1)
        cards = Gtk.Box(spacing=16, homogeneous=True)
        for kind, name, desc, variants in CARDS:
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            card = Gtk.Button()
            card.add_css_class("eo-card")
            cb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            stripe = Gtk.Box()
            stripe.add_css_class(f"eo-stripe-{kind}")
            cb.append(stripe)
            row = Gtk.Box(spacing=12)
            ic = Gtk.Image.new_from_file(ICON[kind])
            ic.set_pixel_size(56)
            row.append(ic)
            nb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER, spacing=2)
            n = Gtk.Label(label=name, xalign=0)
            n.add_css_class("eo-card-name")
            dd = Gtk.Label(label=desc(), xalign=0)
            dd.add_css_class("eo-card-desc")
            nb.append(n)
            nb.append(dd)
            row.append(nb)
            cb.append(row)
            card.set_child(cb)
            card.connect("clicked", lambda _b, k=kind, v=variants[0][0]: self.create(k, v))
            col.append(card)
            chips = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=4, column_spacing=6, row_spacing=6)
            for v, vl in variants:
                ch = Gtk.Button(label=vl())
                ch.add_css_class("eo-chip")
                ch.connect("clicked", lambda _b, k=kind, v=v: self.create(k, v))
                chips.append(ch)
            col.append(chips)
            cards.append(col)
        outer.append(cards)

        # недавні
        s2 = Gtk.Label(label=tr("НЕДАВНІ", "RECENT", "НЕДАВНИЕ"), xalign=0)
        s2.add_css_class("eo-section")
        outer.append(s2)
        self.recent = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=2, min_children_per_line=2,
                                  column_spacing=10, row_spacing=10, homogeneous=True, valign=Gtk.Align.START)
        scr = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        scr.set_child(self.recent)
        outer.append(scr)

        self.win.present()
        self.refresh()
        GLib.timeout_add_seconds(4, self.tick)

    def on_theme(self, t):
        self.fox.set_from_file(t["fox"])

    def tick(self):
        self.refresh()
        return True

    def refresh(self):
        ok = lo_installed()
        self.banner.set_visible(not ok or self.installing)
        if self.installing:
            self.ban_text.set_text(tr("Встановлюю Ember Office (≈ 400 МБ)… можна закрити вікно — встановиться у фоні.",
                                      "Installing Ember Office (≈ 400 MB)… you can close this window.",
                                      "Устанавливаю Ember Office (≈ 400 МБ)… можно закрыть окно."))
            self.ban_spin.start()
            self.ban_btn.set_visible(False)
        elif not ok:
            self.ban_text.set_text(tr("Офіс ще не встановлено. Натисни «Встановити» — знадобиться інтернет і пароль.",
                                      "Office isn't installed yet. Press Install — needs internet and your password.",
                                      "Офис ещё не установлен. Нажми «Установить» — нужен интернет и пароль."))
            self.ban_spin.stop()
            self.ban_btn.set_visible(True)
        child = self.recent.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.recent.remove(child)
            child = nxt
        docs = recent_docs()
        if not docs:
            e = Gtk.Label(label=tr("Тут з'являться твої документи", "Your documents will appear here", "Здесь появятся твои документы"), xalign=0)
            e.add_css_class("eo-empty")
            self.recent.append(e)
        for d in docs:
            b = Gtk.Button()
            b.add_css_class("eo-recent")
            r = Gtk.Box(spacing=12)
            ic = Gtk.Image.new_from_file(ICON[d["kind"]])
            ic.set_pixel_size(36)
            r.append(ic)
            tb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER)
            nm = Gtk.Label(label=os.path.basename(d["path"]), xalign=0, ellipsize=3)
            nm.add_css_class("eo-recent-name")
            folder = os.path.dirname(d["path"]).replace(HOME, "~")
            mt = Gtk.Label(label=f'{folder} · {datetime.datetime.fromtimestamp(d["time"]).strftime("%d.%m %H:%M")}', xalign=0, ellipsize=1)
            mt.add_css_class("eo-recent-meta")
            tb.append(nm)
            tb.append(mt)
            r.append(tb)
            b.set_child(r)
            b.connect("clicked", lambda _b, p=d["path"]: self.open_path(p))
            self.recent.append(b)
        return False

    def create(self, kind, variant):
        if not lo_installed():
            return self.install()
        new_doc(kind, variant, self.css.t, lang())

    def open_path(self, p):
        if not lo_installed():
            return self.install()
        apply_lo_theme(self.css.t)
        soffice([p])

    def open_file(self, _b):
        dlg = Gtk.FileDialog(title=tr("Відкрити документ", "Open a document", "Открыть документ"))
        flt = Gtk.FileFilter()
        flt.set_name(tr("Документи", "Documents", "Документы"))
        for e in OFFICE_EXT:
            flt.add_pattern("*" + e)
            flt.add_pattern("*" + e.upper())
        store = Gio.ListStore.new(Gtk.FileFilter)
        store.append(flt)
        dlg.set_filters(store)

        def done(d, res):
            try:
                f = d.open_finish(res)
            except GLib.Error:
                return
            if f and f.get_path():
                self.open_path(f.get_path())
        dlg.open(self.win, None, done)

    def install(self, *_a):
        if self.installing:
            return
        self.installing = True
        self.refresh()
        proc = Gio.Subprocess.new(["pkexec", "pacman", "-S", "--needed", "--noconfirm"] + LO_PKGS, Gio.SubprocessFlags.NONE)

        def fin(p, res):
            try:
                p.wait_finish(res)
            except GLib.Error:
                pass
            self.installing = False
            apply_lo_theme(self.css.t)
            self.refresh()
        proc.wait_async(None, fin)


Office().run([])
