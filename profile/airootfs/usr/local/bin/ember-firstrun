#!/bin/bash
# Выполняется при каждом входе в Hyprland; первый вход — приветствие.
# Также досоздаёт конфиги из /etc/skel, если пользователь их удалил.
set -u
. /usr/share/ember/i18n.sh
for f in .config/hypr/mode.conf .config/hypr/user.conf .config/ember/widgets.json; do
    [ -e "$HOME/$f" ] || { mkdir -p "$(dirname "$HOME/$f")"; cp "/etc/skel/$f" "$HOME/$f" 2>/dev/null; }
done
mkdir -p "$HOME/Pictures"

# Живая сессия с флешки: сразу показать окно приветствия (Wi-Fi + установка)
if grep -q archisobasedir /proc/cmdline 2>/dev/null; then
    (sleep 2; ember-welcome >/dev/null 2>&1) &
fi

marker="$HOME/.config/ember/.welcomed"
if [ ! -e "$marker" ]; then
    touch "$marker"
    sleep 3
    notify-send -i /usr/share/ember/icons/fox-avatar.png "$(msg "Ласкаво просимо до Ember OS" "Welcome to Ember OS")" \
        "$(msg "Win+Enter — командний рядок · Win+D — програми · Win+L — блокування" "Win+Enter — command line · Win+D — apps · Win+L — lock")"
fi

# Сообщить, когда в фоне докачаются Steam / Wine / Hydra (установленная система)
if [ -e /etc/systemd/system/multi-user.target.wants/ember-setup-apps.service ] && [ ! -e /var/lib/ember/apps-done ] \
   && ! grep -q archisobasedir /proc/cmdline; then
    (
        notified=""
        while sleep 15; do
            st=$(cat /var/lib/ember/apps-status 2>/dev/null)
            case "$st" in
                installing) [ -z "$notified" ] && notify-send -i /usr/share/ember/icons/fox-avatar.png "Ember OS" "$(msg "У фоні встановлюю Steam, Wine та Hydra Launcher…" "Installing Steam, Wine and Hydra Launcher in the background…")" && notified=1 ;;
                done) notify-send -i /usr/share/ember/icons/fox-avatar.png "Ember OS" "$(msg "Готово: Steam, Wine та Hydra Launcher встановлено 🎮" "Done: Steam, Wine and Hydra Launcher are installed 🎮")"; break ;;
                failed) notify-send -u critical "Ember OS" "$(msg "Не вдалося докачати програми. Спробуй /download steam і /download hydra" "Could not download apps. Try /download steam and /download hydra")"; break ;;
            esac
        done
    ) &
fi
